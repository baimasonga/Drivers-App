# AVDP SmartFleet — production environment variables
# Copy to `.env` and fill in real values. Never commit `.env`.

# 32+ char random secret. Generate with: openssl rand -base64 48
JWT_KEY=replace-with-a-long-random-secret-of-at-least-32-chars

# JWT issuer/audience. Keep defaults unless you have a reason.
JWT_ISSUER=AvdpSmartFleet
JWT_AUDIENCE=AvdpSmartFleetClients

# URL that hosts the driver PWA — used for CORS allowlist
DRIVER_APP_URL=https://driver.avdp.example.org

# GPS-Trace integration
GPS_TRACE_USE_REAL=false
GPS_TRACE_BASE_URL=https://hosting.gps-trace.com
GPS_TRACE_TOKEN=
