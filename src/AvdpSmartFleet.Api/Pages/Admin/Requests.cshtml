@page "/admin/requests"
@model AvdpSmartFleet.Api.Pages.Admin.RequestsModel
@{ ViewData["Title"] = "Travel Requests"; }
<p class="muted small">@Model.Items.Count request(s)</p>

<div class="card" style="padding:0">
    <table>
        <thead>
            <tr><th>Code</th><th>Requester</th><th>Department</th><th>Purpose</th><th>Departure</th><th>Vehicle</th><th>Driver</th><th>Status</th><th>Score</th></tr>
        </thead>
        <tbody>
        @foreach (var r in Model.Items)
        {
            string badgeClass = r.Status switch
            {
                "Closed" or "Verified" => "success",
                "Rejected" or "Cancelled" or "Aborted" => "danger",
                "Queried" or "Escalated" => "warn",
                "PendingFleetReview" or "PendingApproval" or "PendingVerification" => "info",
                _ => "neutral"
            };
            <tr>
                <td><a href="/admin/requests/@r.Id">@r.Code</a></td>
                <td>@r.Requester</td>
                <td>@r.Department</td>
                <td>@r.Purpose</td>
                <td>@r.PlannedDeparture.ToString("yyyy-MM-dd HH:mm")</td>
                <td>@(r.Vehicle ?? "—")</td>
                <td>@(r.Driver ?? "—")</td>
                <td><span class="badge @badgeClass">@r.Status</span></td>
                <td>@(r.Score.HasValue ? r.Score.Value.ToString("F0") : "—")</td>
            </tr>
        }
        </tbody>
    </table>
</div>
