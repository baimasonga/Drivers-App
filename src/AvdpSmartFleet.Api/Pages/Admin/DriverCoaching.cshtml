@page "/admin/drivers/{id:int}/coaching"
@model AvdpSmartFleet.Api.Pages.Admin.DriverCoachingModel
@{ ViewData["Title"] = "Coaching · " + (Model.Coaching?.Name ?? "Driver"); }

<p><a href="/admin/leaderboard">← Back to leaderboard</a></p>

@if (Model.Coaching == null) { <p class="muted">Driver not found.</p> }
else
{
    <h2>@Model.Coaching.Name</h2>
    <p class="muted small">@Model.Coaching.TripsAnalysed trip(s) analysed · avg score @Model.Coaching.AvgScore%</p>

    <div class="card">
        <h3>🤖 AI-driven assessment</h3>
        <p style="font-size:15px;line-height:1.5">@Model.Coaching.OverallVerdict</p>
    </div>

    <div class="card">
        <h3>Pattern-detected coaching tips</h3>
        @if (Model.Coaching.Tips.Count == 0) { <p class="muted">No tips yet.</p> }
        @foreach (var t in Model.Coaching.Tips)
        {
            string color = t.Kind switch
            {
                AvdpSmartFleet.Api.Services.TipKind.Praise => "var(--success)",
                AvdpSmartFleet.Api.Services.TipKind.Warning => "var(--danger)",
                _ => "var(--warning)"
            };
            string bg = t.Kind switch
            {
                AvdpSmartFleet.Api.Services.TipKind.Praise => "var(--success-bg)",
                AvdpSmartFleet.Api.Services.TipKind.Warning => "var(--danger-bg)",
                _ => "var(--warning-bg)"
            };
            <div style="border-left:3px solid @color;padding:12px 16px;margin:12px 0;background:@bg;border-radius:6px">
                <div style="font-weight:600;display:flex;justify-content:space-between">
                    <span>@t.Title</span>
                    <span class="muted small">Evidence: @((t.Evidence * 100).ToString("F0"))%</span>
                </div>
                <div style="margin-top:6px;font-size:14px">@t.Detail</div>
            </div>
        }
    </div>
}
