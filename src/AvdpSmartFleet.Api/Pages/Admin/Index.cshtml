@page "/admin"
@model AvdpSmartFleet.Api.Pages.Admin.IndexModel
@{ ViewData["Title"] = "Dashboard"; }

<h1>Dashboard</h1>
<p class="muted">Last 30 days · live from the database</p>

<div class="kpis">
    <div class="kpi"><div class="label">Total requests</div><div class="value">@Model.TotalRequests</div></div>
    <div class="kpi"><div class="label">Approved</div><div class="value">@Model.Approved</div></div>
    <div class="kpi"><div class="label">Completed</div><div class="value">@Model.Completed</div></div>
    <div class="kpi"><div class="label">Open exceptions</div><div class="value">@Model.OpenExceptions</div></div>
    <div class="kpi"><div class="label">Unauthorized movements</div><div class="value">@Model.UnauthorizedMovements</div></div>
    <div class="kpi"><div class="label">Avg compliance</div><div class="value">@Model.AvgCompliance.ToString("F0")%</div></div>
</div>

<div class="card" style="margin-top: 24px;">
    <h2>Recent activity</h2>
    <table>
        <thead>
            <tr><th>Code</th><th>Purpose</th><th>Requester</th><th>Vehicle</th><th>Status</th><th>Score</th></tr>
        </thead>
        <tbody>
        @foreach (var r in Model.Recent)
        {
            <tr>
                <td><a href="/admin/requests/@r.Id">@r.RequestCode</a></td>
                <td>@r.Purpose</td>
                <td>@r.Requester</td>
                <td>@(r.Vehicle ?? "—")</td>
                <td><span class="badge">@r.Status</span></td>
                <td>@(r.ComplianceScore.HasValue ? r.ComplianceScore.Value.ToString("F0") + "%" : "—")</td>
            </tr>
        }
        </tbody>
    </table>
</div>
