@page "/admin/exceptions"
@model AvdpSmartFleet.Api.Pages.Admin.ExceptionsModel
@{ ViewData["Title"] = "Exceptions"; }
<p class="muted small">@Model.Items.Count exception(s) recorded</p>

<div class="card" style="padding:0">
    <table>
        <thead><tr><th>Trip</th><th>Type</th><th>Status</th><th>Description</th><th>Detected</th></tr></thead>
        <tbody>
        @foreach (var e in Model.Items)
        {
            string sb = e.Status switch
            {
                "Open" => "danger",
                "UnderReview" => "warn",
                "Resolved" => "success",
                "Escalated" => "danger",
                "Appealed" => "info",
                _ => "neutral"
            };
            <tr>
                <td><a href="/admin/requests/@e.TripId">@e.TripCode</a></td>
                <td>@e.Type</td>
                <td><span class="badge @sb">@e.Status</span></td>
                <td>@e.Description</td>
                <td>@e.DetectedAt.ToString("yyyy-MM-dd HH:mm")</td>
            </tr>
        }
        </tbody>
    </table>
</div>
