@{
    var title = ViewData["Title"] as string ?? "Dashboard";
    var path = Context.Request.Path.Value ?? "";
    bool IsActive(string prefix) => path.StartsWith(prefix, StringComparison.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0f3d18" />
    <title>@title · AVDP SmartFleet</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/admin.css" />
</head>
<body>
<div class="layout">
    <aside class="sidebar">
        <div class="sidebar-brand">
            <div class="logo-mark">AVDP</div>
            <div>
                <div class="brand-title">SmartFleet</div>
                <div class="brand-subtitle">Logbook</div>
            </div>
        </div>
        <nav class="sidebar-nav">
            <div class="nav-section">Overview</div>
            <a href="/admin" class="nav-link @(path == "/admin" ? "active" : "")">
                <svg class="ico" viewBox="0 0 24 24"><path d="M3 12 12 3l9 9v9h-6v-6H9v6H3z" /></svg>
                Dashboard
            </a>
            <a href="/admin/reports" class="nav-link @(IsActive("/admin/reports") ? "active" : "")">
                <svg class="ico" viewBox="0 0 24 24"><path d="M4 4h12l4 4v12H4zM14 4v6h6" /></svg>
                Reports
            </a>

            <div class="nav-section">Operations</div>
            <a href="/admin/fleet-live" class="nav-link @(IsActive("/admin/fleet-live") ? "active" : "")">
                <svg class="ico" viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3M4.9 4.9l2.1 2.1M17 17l2.1 2.1M4.9 19.1L7 17M17 7l2.1-2.1"/></svg>
                Live Fleet
            </a>
            <a href="/admin/requests" class="nav-link @(IsActive("/admin/requests") ? "active" : "")">
                <svg class="ico" viewBox="0 0 24 24"><path d="M5 3h14v18l-7-3-7 3z" /></svg>
                Travel Requests
            </a>
            <a href="/admin/chat" class="nav-link @(IsActive("/admin/chat") ? "active" : "")">
                <svg class="ico" viewBox="0 0 24 24"><path d="M21 11.5a8.38 8.38 0 01-.9 3.8 8.5 8.5 0 01-7.6 4.7 8.38 8.38 0 01-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 01-.9-3.8 8.5 8.5 0 014.7-7.6 8.38 8.38 0 013.8-.9h.5a8.48 8.48 0 018 8v.5z"/></svg>
                Dispatch Chat
            </a>
            <a href="/admin/exceptions" class="nav-link @(IsActive("/admin/exceptions") ? "active" : "")">
                <svg class="ico" viewBox="0 0 24 24"><path d="M12 2 2 22h20zM12 9v6M12 18v.5" /></svg>
                Exceptions
            </a>

            <div class="nav-section">Fleet</div>
            <a href="/admin/vehicles" class="nav-link @(IsActive("/admin/vehicles") ? "active" : "")">
                <svg class="ico" viewBox="0 0 24 24"><path d="M3 13l2-6h14l2 6v6h-4v-2H7v2H3zM6 18a1.5 1.5 0 100-3 1.5 1.5 0 000 3M18 18a1.5 1.5 0 100-3 1.5 1.5 0 000 3" /></svg>
                Vehicles
            </a>
            <a href="/admin/drivers" class="nav-link @(IsActive("/admin/drivers") ? "active" : "")">
                <svg class="ico" viewBox="0 0 24 24"><circle cx="12" cy="8" r="4" /><path d="M4 21a8 8 0 0116 0" /></svg>
                Drivers
            </a>
            <a href="/admin/maintenance" class="nav-link @(IsActive("/admin/maintenance") ? "active" : "")">
                <svg class="ico" viewBox="0 0 24 24"><path d="M14.7 6.3a4 4 0 105.6 5.6L18 14l4 4-3 3-4-4-2.1 2.3a6 6 0 11-8.5-8.5l4.2-4.2a4 4 0 015.6 0z"/></svg>
                Maintenance
            </a>
            <a href="/admin/leaderboard" class="nav-link @(IsActive("/admin/leaderboard") ? "active" : "")">
                <svg class="ico" viewBox="0 0 24 24"><path d="M8 21h8M12 17v4M7 4h10v6a5 5 0 01-10 0zM4 4h3v3a3 3 0 01-3-3zM17 4h3a3 3 0 01-3 3z"/></svg>
                Leaderboard
            </a>
            <a href="/admin/geofences" class="nav-link @(IsActive("/admin/geofences") ? "active" : "")">
                <svg class="ico" viewBox="0 0 24 24"><circle cx="12" cy="10" r="3" /><path d="M12 2a8 8 0 018 8c0 6-8 12-8 12S4 16 4 10a8 8 0 018-8z" /></svg>
                Geofences
            </a>

            <div class="nav-section">Admin</div>
            <a href="/admin/users" class="nav-link @(IsActive("/admin/users") ? "active" : "")">
                <svg class="ico" viewBox="0 0 24 24"><circle cx="9" cy="8" r="4" /><path d="M2 21a7 7 0 0114 0M17 11a3 3 0 100-6M22 21a5 5 0 00-5-5" /></svg>
                Users
            </a>
            <a href="/swagger" target="_blank" class="nav-link">
                <svg class="ico" viewBox="0 0 24 24"><path d="M8 16l-4-4 4-4M16 8l4 4-4 4M14 4l-4 16" /></svg>
                API Docs
            </a>
        </nav>
        <div class="sidebar-foot">
            <div class="muted small">v1.0 · MVP</div>
        </div>
    </aside>

    <div class="main">
        <header class="topbar">
            <div>
                <h1 class="page-title">@title</h1>
            </div>
            <div class="topbar-actions">
                <a href="/admin/requests/new" class="btn btn-primary">
                    <svg class="ico" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14" /></svg>
                    New Request
                </a>
            </div>
        </header>
        <div class="content">
            @RenderBody()
        </div>
    </div>
</div>
</body>
</html>
